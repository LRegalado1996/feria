{
  "name": "feria",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "bash scripts/run-parallel.sh --self-test && bash scripts/run-parallel.sh 'pnpm run -s check:structure' 'pnpm run -s check:ratchet' 'pnpm run -s knip' 'pnpm run -s check:lint' 'pnpm run -s check:scripts'",
    "check:lint": "ultracite check --type-aware",
    "check:ratchet": "node scripts/ratchet.mjs --self-test && node scripts/ratchet.mjs",
    "check:scripts": "bash scripts/lint-sh.sh --self-test && bash scripts/lint-sh.sh && bash scripts/check-playwright-pin.sh --self-test && bash scripts/format-edited-file.sh --self-test && bash scripts/vercel-ignore.sh --self-test && bash scripts/worktree.sh self-test && bash scripts/cloud-session-start.sh --self-test && node .github/scripts/pr-summary.mjs --self-test && node --test \".github/scripts/*.test.mjs\"",
    "check:structure": "konsistent && bash scripts/lint-router-db.sh --self-test && bash scripts/lint-router-db.sh",
    "fix": "ultracite fix --type-aware",
    "knip": "PLAYWRIGHT_SKIP_SERVER=true knip --include files,dependencies --no-config-hints",
    "knip:exports": "PLAYWRIGHT_SKIP_SERVER=true knip --include exports,types --no-config-hints",
    "ratchet:prune": "node scripts/ratchet.mjs --prune",
    "verify": "turbo run check typecheck test:unit --continue",
    "test": "vitest",
    "test:run": "pnpm run -s test:unit && pnpm run -s test:integration",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:integration": "bash scripts/worktree.sh ensure --quiet && vitest run --config vitest.integration.config.ts",
    "typecheck": "tsrs --noEmit && tsrs --noEmit -p src/e2e/tsconfig.json",
    "dev": "bash scripts/worktree.sh dev",
    "start": "next start",
    "preview": "next build && next start",
    "cloud:provision": "WT_CLOUD_SESSION=1 bash scripts/cloud-session-start.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bash scripts/worktree.sh ensure --quiet && drizzle-kit migrate",
    "db:push": "bash scripts/worktree.sh ensure --quiet && drizzle-kit push",
    "db:seed": "bash scripts/worktree.sh ensure --quiet --no-seed && tsx --env-file-if-exists=.env src/server/db/run-seed.ts",
    "db:studio": "bash scripts/worktree.sh ensure --quiet && drizzle-kit studio",
    "prepare": "husky",
    "e2e": "bash scripts/worktree.sh ensure --quiet && playwright test --config=src/e2e/playwright.config.ts",
    "e2e:ui": "bash scripts/worktree.sh ensure --quiet && playwright test --config=src/e2e/playwright.config.ts --ui",
    "e2e:headed": "bash scripts/worktree.sh ensure --quiet && playwright test --config=src/e2e/playwright.config.ts --headed",
    "e2e:debug": "bash scripts/worktree.sh ensure --quiet && playwright test --config=src/e2e/playwright.config.ts --debug",
    "e2e:report": "playwright show-report src/e2e/playwright-report",
    "e2e:ci": "bash scripts/verify-ci.sh --only-e2e",
    "verify:ci": "bash scripts/verify-ci.sh",
    "verify:ci:reset": "bash scripts/verify-ci.sh --reset-db-only",
    "wt": "bash scripts/worktree.sh",
    "wt:provision": "bash scripts/worktree.sh provision",
    "wt:app": "bash scripts/worktree.sh app",
    "wt:dev": "bash scripts/worktree.sh dev",
    "wt:pause": "bash scripts/worktree.sh pause",
    "wt:down": "bash scripts/worktree.sh down",
    "wt:gc": "bash scripts/worktree.sh gc",
    "wt:doctor": "bash scripts/worktree.sh doctor",
    "wt:env": "bash scripts/worktree.sh env",
    "wt:ports": "bash scripts/worktree.sh ports",
    "wt:status": "bash scripts/worktree.sh status",
    "wt:logs": "bash scripts/worktree.sh logs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "@orpc/client": "1.16.1",
    "@orpc/openapi": "1.16.1",
    "@orpc/server": "1.16.1",
    "@orpc/tanstack-query": "1.16.1",
    "@orpc/zod": "1.16.1",
    "@sentry/nextjs": "10.76.2",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.105.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/functions": "3.10.6",
    "@vercel/speed-insights": "2.0.0",
    "better-auth": "1.7.15",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "evlog": "2.33.1",
    "lucide-react": "1.61.0",
    "next": "16.4.4",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "happy-dom": "20.14.6",
    "husky": "9.1.7",
    "knip": "6.43.0",
    "konsistent": "1.0.0-beta.13",
    "lint-staged": "17.6.0",
    "msw": "2.15.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "ultracite": "7.12.4",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,json,jsonc,css,scss,md,mdx,yml,yaml,toml}": [
      "ultracite fix",
      "bash -c 'pnpm exec konsistent' --",
      "bash -c 'node scripts/ratchet.mjs' --"
    ],
    "scripts/*.sh": [
      "bash scripts/lint-sh.sh"
    ]
  },
  "packageManager": "pnpm@11.28.5"
}
