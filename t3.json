{
  "$schema": "https://t3.codes/schema/t3.json",
  "defaultThreadEnvMode": "worktree",
  "scripts": [
    {
      "name": "Setup worktree",
      "command": "pnpm wt:provision",
      "icon": "configure",
      "runOnWorktreeCreate": true
    },
    {
      "name": "Dev server",
      "command": "pnpm wt:dev",
      "icon": "play"
    },
    {
      "name": "Pause services",
      "command": "pnpm wt:pause",
      "icon": "configure",
      "runOnSettle": true
    }
  ]
}
