# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# With access to the Vercel project, skip the copy: `vercel link`, then
# `vercel env pull .env` writes the Development values, and `pnpm wt:provision`
# points the database and auth URLs at this worktree (README § Getting started).

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Database (use localhost for local dev, docker-compose overrides with 'db' hostname)
DATABASE_URL="postgresql://feria:feria@localhost:5432/feria"

# Deployments only, set in Vercel and never here (docs/agents/database.md
# § Preview databases). Production and qa read their own database URL, because
# the Neon integration rewrites DATABASE_URL for every preview deployment.
# PRODUCTION_DATABASE_URL=""
# QA_DATABASE_URL=""
# The direct (non-pooled) endpoint `pnpm db:migrate` uses in production and qa.
# MIGRATION_DATABASE_URL=""
# "1" once every preview gets its own Neon branch: production and qa then
# refuse to fall back to DATABASE_URL.
# NEON_PREVIEW_BRANCHES=""

# Better Auth (BETTER_AUTH_SECRET is auto-generated on first startup)
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET=""

# Vercel Blob: the store for article, banner and logo images. Local runs use
# the qa store's token (`vercel env pull`); production has its own store.
BLOB_READ_WRITE_TOKEN=""

# Vercel AI Gateway (the Claude calls). `vercel env pull` writes a short-lived
# VERCEL_OIDC_TOKEN that authenticates local calls; pull again when it expires.
# Set a key only on a machine that cannot pull one.
AI_GATEWAY_API_KEY=""

# Optional. Guards /api/health: callers present it as a bearer token or
# ?secret=. At least 16 characters. Unset, the probe is public.
HEALTH_SECRET=""

# Optional. Sentry error reporting (docs/agents/observability.md). Unset,
# Sentry stays off. The last three upload source maps at build time.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
