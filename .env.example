# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# With access to the Vercel project, skip the copy: `vercel link`, then
# `vercel env pull .env` writes the Development values, and `pnpm wt:provision`
# points the database and auth URLs at this worktree (README § Getting started).

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Database (use localhost for local dev, docker-compose overrides with 'db' hostname)
DATABASE_URL="postgresql://feria:feria@localhost:5432/feria"

# Deployments only, set in Vercel and never here (docs/agents/database.md
# § Preview databases). Production and qa read their own database URL, because
# the Neon integration rewrites DATABASE_URL for every preview deployment.
# PRODUCTION_DATABASE_URL=""
# QA_DATABASE_URL=""
# The direct (non-pooled) endpoint `pnpm db:migrate` uses in production and qa.
# MIGRATION_DATABASE_URL=""
# "1" once every preview gets its own Neon branch: production and qa then
# refuse to fall back to DATABASE_URL.
# NEON_PREVIEW_BRANCHES=""

# Better Auth (BETTER_AUTH_SECRET is auto-generated on first startup)
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET=""

# Optional. Only `pnpm db:create-superadmin` reads these (FER-009): the first
# login of a fresh database, since sign-up is closed. Set them on the machine
# that runs the script, against the database it points at, and remove the
# password afterwards. The script is refused once any login exists (every
# login is an admin since FER-038; the names keep the role it gave before).
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""
# SUPERADMIN_NAME=""

# Vercel Blob: the store for uploaded images (FER-011). Local runs use the qa
# store's token (`vercel env pull`); production has its own store. Each
# deployment writes under its own folder (`local/`, `preview/`, `qa/`,
# `production/`). Without it the admin cannot upload; the build reads it too,
# for the host `next/image` may serve.
BLOB_READ_WRITE_TOKEN=""

# Vercel AI Gateway (the Claude calls). `vercel env pull` writes a short-lived
# VERCEL_OIDC_TOKEN that authenticates local calls; pull again when it expires.
# Set a key only on a machine that cannot pull one.
AI_GATEWAY_API_KEY=""

# Optional. The launch switch. Unset, production shows the coming-soon page
# on every storefront address and everything else is open. Launch day is
# setting it to "true" in Vercel's Production environment and redeploying;
# "false" closes any environment (to see the coming-soon page locally).
STOREFRONT_LAUNCHED=""

# The secret Vercel sends to the scheduled jobs (`crons` in vercel.json, the
# routes under /api/cron), as `Authorization: Bearer <secret>`. At least 16
# characters (`openssl rand -hex 32`). Required on the production deployment,
# which is the only one Vercel runs crons on; unset elsewhere, a cron route
# answers 503. Set it locally only to call a cron route by hand.
CRON_SECRET=""

# Optional. Guards /api/health: callers present it as a bearer token or
# ?secret=. At least 16 characters. Unset, the probe is public.
HEALTH_SECRET=""

# Optional. Sentry error reporting (docs/agents/observability.md). Unset,
# Sentry stays off. The last three upload source maps at build time.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
